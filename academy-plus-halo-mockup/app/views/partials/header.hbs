<header class="app-header position-sticky top-0 w-100">
  <nav class="navbar navbar-expand-lg navbar-light px-3 px-lg-4">
    <ul class="navbar-nav">
      <li class="nav-item d-block d-xl-none">
        <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
          <i class="ti ti-menu-2"></i>
        </a>
      </li>
    </ul>

    <div class="navbar-collapse justify-content-end px-0">
      <div class="d-flex align-items-center gap-3 ms-auto">

        <!-- LANGUAGE -->
        <div class="nav-item dropdown">
          <a
            class="nav-link nav-icon-hover d-flex align-items-center gap-2 px-2"
            href="javascript:void(0)"
            id="languageDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            {{#if (eq i18n.language 'pt')}}
              <img src="/assets/images/flags/pt.png" alt="Portuguese" width="22" height="16" class="rounded-1 border">
              <span class="d-none d-md-inline text-dark fw-medium">PT</span>
            {{else}}
              <img src="/assets/images/flags/gb.png" alt="English" width="22" height="16" class="rounded-1 border">
              <span class="d-none d-md-inline text-dark fw-medium">EN</span>
            {{/if}}
            <i class="ti ti-chevron-down fs-4"></i>
          </a>

          <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up shadow-sm border-0 rounded-3"
            aria-labelledby="languageDropdown">
            <a href="/lang?lng=pt" class="dropdown-item d-flex align-items-center gap-2 py-2">
              <img src="/assets/images/flags/pt.png" alt="Portuguese" width="22" height="16" class="rounded-1 border">
              <span>PT</span>
            </a>
            <a href="/lang?lng=en" class="dropdown-item d-flex align-items-center gap-2 py-2">
              <img src="/assets/images/flags/gb.png" alt="English" width="22" height="16" class="rounded-1 border">
              <span>EN</span>
            </a>
          </div>
        </div>

        {{#if user}}
          <div class="d-none d-md-flex flex-column gap-1 px-3 py-2 rounded-3 border bg-body-tertiary" style="min-width: 240px;">
            <div class="d-flex align-items-center justify-content-between gap-2">
              <span class="small text-muted">{{t 'header.level'}} {{user.level}}</span>
              <span class="small fw-semibold text-primary">{{t 'header.xp_to_next_level' xp=user.xpRemaining}}</span>
            </div>
            <div class="position-relative">
              <div class="progress" style="height: 22px;">
                <div
                  class="progress-bar bg-primary"
                  role="progressbar"
                  aria-valuenow="{{user.levelProgress}}"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  style="width: {{user.levelProgress}}%;"
                ></div>
              </div>
            </div>
          </div>
        {{/if}}

        <!-- USER -->
        <div class="nav-item dropdown">
          <a
            class="nav-link d-flex align-items-center gap-2 px-2"
            href="javascript:void(0)"
            id="userDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <img
              src="{{#if user.avatar_url}}{{user.avatar_url}}{{else}}{{#if user.avatar}}{{user.avatar}}{{else}}/assets/images/profile/avatar.png{{/if}}{{/if}}"
              alt="User avatar"
              width="38"
              height="38"
              class="rounded-circle border"
              style="object-fit: cover;"
            >
            <span class="d-none d-md-inline text-dark fw-medium">{{#if user}}{{user.username}}{{else}}{{ t 'header.guest' }}{{/if}}</span>
            <i class="ti ti-chevron-down fs-4"></i>
          </a>

          <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up shadow-sm border-0 rounded-3"
            aria-labelledby="userDropdown">
            {{#if user}}
              <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2" id="profile-logout">
                <i class="ti ti-logout fs-5 text-danger"></i>
                <span>{{ t 'header.logout' }}</span>
              </a>
              <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2">
                <i class="ti ti-settings fs-5 text-primary"></i>
                <span>{{ t 'header.settings' }}</span>
              </a>
              <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2">
                <i class="ti ti-badge fs-5 text-warning"></i>
                <span>{{ t 'header.level' }}</span>
              </a>
              <a href="#" class="dropdown-item d-flex align-items-center gap-2 py-2">
                <i class="ti ti-star fs-5 text-warning"></i>
                <span>{{ t 'header.stars' }}</span>
              </a>
              <a href="/statistics" class="dropdown-item d-flex align-items-center gap-2 py-2">
                <i class="ti ti-chart-bar fs-5 text-info"></i>
                <span>{{ t 'header.statistics' }}</span>
              </a>
            {{else}}
              <a href="/login" class="dropdown-item d-flex align-items-center gap-2 py-2">
                <i class="ti ti-login fs-5 text-primary"></i>
                <span>{{ t 'header.login' }}</span>
              </a>
            {{/if}}

          </div>
        </div>

        <!-- ISEP LOGO -->
        <a
          href="https://www.isep.ipp.pt/"
          target="_blank"
          rel="noopener noreferrer"
          class="d-flex align-items-center ps-1"
        >
          <img
            src="/assets/images/logos/isep.png"
            alt="ISEP logo"
            class="img-fluid"
            style="max-height: 34px; width: auto;"
          >
        </a>

      </div>
    </div>
  </nav>
</header>