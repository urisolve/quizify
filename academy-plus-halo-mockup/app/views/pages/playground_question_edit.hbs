<div class="container-fluid">
  <div class="row g-4">

    <!-- Topic header -->
    <div class="col-12 mb-0">
      <section class="card border-0 halo-hero-card overflow-hidden">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="halo-section-icon bg-light-info text-info">
              <i class="ti ti-edit"></i>
            </span>
            <div class="flex-grow-1">
              <h2 class="fw-semibold mb-0 fs-4">{{subtopicT subtopicId 'name'}}</h2>
              <p class="mb-0 text-muted small" style="text-align: justify;">
                {{subtopicT subtopicId 'description'}}
              </p>
            </div>
            <div class="d-flex gap-2 small">
              <span class="text-muted">#{{question.id}}</span>
              <span class="badge bg-light-secondary text-secondary">{{ t 'playgroundreview.type' }}{{question.question_type}}</span>
              <span class="badge bg-light-warning text-warning">{{ t 'playgroundreview.difficulty' }}{{question.difficulty}}</span>
              <span class="badge bg-light-info text-info">{{ t 'playgroundreview.teacheravg' }}{{question.rating_avg_teacher}} ({{question.rating_count_teacher}})</span>
              <span class="badge bg-light-info text-info">{{ t 'playgroundreview.studentravg' }}{{question.rating_avg_student}} ({{question.rating_count_student}})</span>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Flash banner -->
    {{#if flash}}
      <div class="col-12">
        <div class="alert alert-{{flash.type}} d-flex align-items-center gap-2 mb-0" role="alert">
          <i class="ti {{#if (eq flash.type 'success')}}ti-circle-check{{else}}ti-alert-circle{{/if}} fs-5"></i>
          <div>
            {{#if flash.messageKey}}{{t flash.messageKey flash.messageVars}}{{else}}{{flash.message}}{{/if}}
          </div>
        </div>
      </div>
    {{/if}}

    <!-- EDIT FIELDS -->
    <div class="col-12 mt-0">
      <section class="card h-100">
        <div class="card-body p-4 d-flex flex-column gap-3">

          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="halo-section-icon bg-light-success text-success">
              <i class="ti ti-pencil"></i>
            </span>
            <h2 class="card-title fw-semibold mb-0 fs-5">{{ t 'questionedit.fields_title' }}</h2>
          </div>

          {{#if question.image}}
            <img src="{{question.image}}" alt="Question image"
                 class="img-fluid rounded-3 mb-2"
                 style="max-height: 450px; object-fit: contain;">
          {{/if}}

          <form method="POST" action="/playground/questions/{{question.id}}"
                class="d-flex flex-column gap-3" data-disable-on-submit>

            <div>
              <label class="form-label fw-semibold" for="question_text">
                {{ t 'questionedit.question' }}
              </label>
              <textarea id="question_text" name="question_text" rows="3"
                        class="form-control" required>{{question.question_text}}</textarea>
            </div>

            <div>
              <label class="form-label fw-semibold" for="correct_answer">
                {{ t 'questionedit.correct' }}
              </label>
              <input id="correct_answer" name="correct_answer" type="text"
                     class="form-control" required value="{{question.correct_answer}}">
            </div>

            <div>
              <label class="form-label fw-semibold">
                {{ t 'questionedit.distractors' }}
              </label>
              <div class="d-flex flex-column gap-2">
                {{#each question.incorrect_answers}}
                  <input type="text" name="incorrect_answer[]"
                         class="form-control" required value="{{this}}">
                {{/each}}
              </div>
            </div>

            <div>
              <label class="form-label fw-semibold" for="feedback">
                {{ t 'questionedit.feedback' }}
              </label>
              <textarea id="feedback" name="feedback" rows="3"
                        class="form-control">{{question.feedback}}</textarea>
            </div>

            <button type="submit" class="btn btn-primary py-2 fw-semibold">
              <span class="btn-label">
                <i class="ti ti-device-floppy me-2"></i>{{ t 'questionedit.save' }}
              </span>
              <span class="btn-loading d-none">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                {{ t 'questionedit.saving' }}
              </span>
            </button>
            
            <a href="/playground" class="btn btn-outline-secondary btn-sm">
              <i class="ti ti-arrow-left me-1"></i>{{ t 'playgroundreview.back' }}
            </a>
          </form>
        </div>
      </section>
    </div>

  </div>
</div>

<script src="/js/pages/playground_review.js"></script>