<div class="container-fluid">
  <div class="row g-4 justify-content-center align-items-stretch">

    <!-- Branding -->
    <div class="col-12 col-lg-6">
      <section class="card h-100 halo-hero-card">
        <div class="card-body p-4 p-lg-5 d-flex flex-column justify-content-center">
          <div class="d-flex align-items-center gap-3 mb-4">
            <img src="assets/images/logos/favicon.png" alt="HALO Logo" style="height: 52px; width: auto;">
            <img src="assets/images/logos/isep.png" alt="ISEP Logo" style="height: 52px; width: auto;"/>
          </div>
          <h1 class="display-6 fw-semibold mb-3">{{ t 'auth.join_halo' }}</h1>
          <p class="fs-5 text-dark halo-lead" style="text-align: justify;">{{ t 'auth.join_halo_sub' }}</p>
        </div>
      </section>
    </div>

    <!-- Register form -->
    <div class="col-12 col-lg-6">
      <section class="card h-100">
        <div class="card-body p-4 p-lg-5">
          <div class="d-flex align-items-center gap-3 mb-4">
            <span class="halo-section-icon bg-light-primary text-primary">
              <i class="ti ti-user-plus"></i>
            </span>
            <div>
              <h2 class="card-title fw-semibold mb-0">{{ t 'auth.welcome_to_urisolve_academy' }}</h2>
              <p class="mb-0 text-muted small">{{ t 'auth.register_to_get_started' }} </p>
            </div>
          </div>

          <div class="auth-container">
            <form id="register-form">

              <div class="mb-3">
                <label class="form-label fw-medium">{{ t 'auth.email' }}</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0">
                    <i class="ti ti-mail text-muted"></i>
                  </span>
                  <input
                    class="form-control border-start-0 ps-0"
                    type="email"
                    name="email"
                    placeholder="{{ t 'auth.email' }}"
                    required
                  />
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-medium">{{ t 'auth.user_name' }}</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0">
                    <i class="ti ti-user text-muted"></i>
                  </span>
                  <input
                    class="form-control border-start-0 ps-0"
                    type="text"
                    name="username"
                    placeholder="{{ t 'auth.user_name' }}"
                    required
                  />
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label fw-medium">{{ t 'auth.password' }}</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0">
                    <i class="ti ti-key text-muted"></i>
                  </span>
                  <input
                    class="form-control border-start-0 ps-0"
                    type="password"
                    name="password"
                    placeholder="{{ t 'auth.enter_password' }}"
                    required
                  />
                </div>
              </div>

              <button class="btn btn-primary w-100 py-2 fw-semibold" id="register-button" type="submit">
                <i class="ti ti-user-plus me-2"></i>{{ t 'auth.register' }}
              </button>

              <div id="register-message" class="mt-3 small text-center"></div>

            </form>
          </div>

          <hr class="my-4">

          <p class="text-center text-muted small mb-0">
            {{ t 'auth.have_an_account?' }}
            <a href="/login" class="text-primary fw-medium">Login</a>
          </p>

        </div>
      </section>
    </div>

  </div>
</div>

<script type="module" src="/js/pages/auth.js"></script>
<script type="module" src="/js/pages/register.js"></script>