<div class="container-fluid">
  <div class="row g-4">

    <!-- HERO -->
    <div class="col-12">
      <section class="card border-0 halo-hero-card overflow-hidden">
        <div class="card-body p-4 p-lg-5">
          <div class="d-flex align-items-center gap-4 flex-wrap">
            <h1 class="display-5 fw-semibold me-5">{{ t 'statistics.statistics' }}</h1>
            <div class="d-flex align-items-center gap-4">
              <span class="halo-section-icon bg-light-warning text-warning">
                <i class="ti ti-trophy"></i>
              </span>
              <div>
                <p class="mb-0 text-muted small">{{ t 'statistics.weekly_points' }}</p>
                <span class="fw-bold fs-4">{{userWeeklyScore}}</span>
              </div>
            </div>
            <div class="d-flex align-items-center gap-4">
              <span class="halo-section-icon bg-light-warning text-warning">
                <i class="ti ti-bolt"></i>
              </span>
              <div>
                <p class="mb-0 text-muted small">{{ t 'statistics.general_performance' }}</p>
                <span class="performance-bolts fs-5">
                  {{#each (range generalPerformanceBolts)}}
                    <i class="ti ti-bolt" style="color:#fbc02d;"></i>
                  {{/each}}
                  {{#each (range generalOutlineBolts)}}
                    <i class="ti ti-bolt" style="color:#e0e0e0;"></i>
                  {{/each}}
                </span>
              </div>
            </div>
            <a href="/leaderboard" class="btn btn-outline-primary px-4 py-2 ms-auto">
              <i class="ti ti-list-numbers me-2"></i>{{ t 'statistics.leaderboard' }}
            </a>
          </div>
        </div>
      </section>
    </div>

    <!-- TOPIC PERFORMANCE TABLE -->
    <div class="col-12 col-xl-8">
      <section class="card h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-4">
            <span class="halo-section-icon bg-light-primary text-primary">
              <i class="ti ti-chart-bar"></i>
            </span>
            <div>
              <h2 class="card-title fw-semibold mb-0">{{ t 'statistics.performance_by_topic' }}</h2>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>{{ t 'statistics.topic' }}</th>
                  <th>{{ t 'statistics.progress' }}</th>
                  <th>{{ t 'statistics.subtopics' }}</th>
                  <th>{{ t 'statistics.performance' }}</th>
                </tr>
              </thead>
              <tbody>
                {{#each topicStats}}
                <tr>
                  <td class="fw-medium">{{topicT this.id 'name'}}</td>
                  <td style="min-width: 160px;">
                    <div class="d-flex align-items-center gap-2">
                      <div class="progress flex-grow-1" style="height: 6px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: {{this.averageProgress}}%"></div>
                      </div>
                      <span class="small text-muted">{{this.averageProgress}}%</span>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-primary-subtle text-primary">
                      {{this.completedSubtopics}} / {{this.totalSubtopics}}
                    </span>
                  </td>
                  <td>
                    <span class="performance-bolts">
                      {{#each (range this.performanceBolts)}}
                        <i class="ti ti-bolt" style="color:#fbc02d;"></i>
                      {{/each}}
                      {{#each (range this.outlineBolts)}}
                        <i class="ti ti-bolt" style="color:#ccc;"></i>
                      {{/each}}
                    </span>
                  </td>
                </tr>
                {{else}}
                <tr>
                  <td colspan="4" class="text-center text-muted py-4">
                    {{ t 'statistics.no_topics_available' }}
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>

    <!-- BADGES -->
    <div class="col-12 col-xl-4">
      <section class="card h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-4">
            <span class="halo-section-icon bg-light-warning text-warning">
              <i class="ti ti-award"></i>
            </span>
            <div>
              <h2 class="card-title fw-semibold mb-0">{{ t 'statistics.badges_and_conquests' }}</h2>
            </div>
          </div>

          {{#if userBadges}}
            <div class="d-flex flex-wrap gap-3">
              {{#each userBadges}}
                <div class="d-flex flex-column align-items-center gap-1"
                  title="{{this.name}} — {{formatDate this.date_earned}}">
                  <span class="d-inline-flex align-items-center justify-content-center rounded-circle border"
                    style="width: 48px; height: 48px; background: #fff3cd; border-color: #fbc02d !important;">
                    <img src="{{this.svg}}" alt="{{this.name}}" style="width: 28px; height: 28px; object-fit: contain;">
                  </span>
                  <span class="small text-muted text-center" style="max-width: 60px; font-size: 0.7rem;">{{this.name}}</span>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class="d-flex flex-column align-items-center justify-content-center py-4 text-muted">
              <span class="halo-section-icon bg-light-warning text-warning mb-3">
                <i class="ti ti-award-off"></i>
              </span>
              <p class="mb-0 small text-center">{{ t 'statistics.nobadges' }}</p>
            </div>
          {{/if}}

        </div>
      </section>
    </div>

  </div>
</div>

<script src="/js/pages/statistics.js"></script>