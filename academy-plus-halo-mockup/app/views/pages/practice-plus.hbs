<div class="container-fluid">
  <div class="row g-4">

    <!-- Flash banner -->
    {{#if flash}}
      <div class="row mb-3">
        <div class="col-12">
          <div class="alert alert-{{flash.type}} d-flex align-items-center gap-2 mb-0" role="alert">
            <i class="ti {{#if (eq flash.type 'success')}}ti-circle-check{{else}}ti-alert-circle{{/if}} fs-5"></i>
            <div>
              {{#if flash.messageKey}}{{t flash.messageKey flash.messageVars}}
              {{else}}{{flash.message}}{{/if}}
            </div>
          </div>
        </div>
      </div>
    {{/if}}


    <!-- Topic Selector -->
    <div class="col-12 col-xl-3">
      <section class="card h-100">
        <div class="card-body p-3">
          <ul class="list-unstyled d-grid gap-2 mb-0" id="topic-selector-list">
            {{#each topics}}
            <li>
              <button
                class="btn w-100 text-start topic-selector-btn {{#if (eq @index ../defaultTopicIndex)}}btn-primary{{else}}btn-outline-secondary{{/if}}"
                data-topic-index="{{@index}}"
              >
                <span class="d-block fw-medium">{{topicT id 'name'}}</span>
                <div class="progress mt-2" style="height: 5px;">
                  <div class="progress-bar"
                    role="progressbar"
                    style="width: {{progress}}%">
                  </div>
                </div>
              </button>
            </li>
            {{/each}}
          </ul>
        </div>
      </section>
    </div>

    <div class="col-12 col-xl-9">
      {{#each topics}}
      <div class="topic-content-block" data-topic-id="{{id}}" style="{{#unless (eq @index ../defaultTopicIndex)}}display:none;{{/unless}}">
        <div class="row g-4">

          <!-- Topic intro card -->
          <div class="col-12">
            <section class="card border-0 halo-hero-card overflow-hidden">
              <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3">
                  <span class="halo-section-icon bg-light-primary text-primary">
                    <i class="ti ti-brain"></i>
                  </span>
                  <div>
                    <h2 class="card-title fw-semibold mb-0">{{topicT id 'name'}}</h2>
                    <p class="mb-0 text-muted small">{{topicT id 'description'}}</p>
                  </div>
                </div>
              </div>
            </section>
          </div>

          <!-- Subtopics -->
          {{#each subtopics}}
          <div class="col-12">
            <section class="card h-100 {{#if (eq progress 100)}}border-success{{/if}}">
              <div class="card-body p-4 d-flex flex-column gap-3">
                <div class="d-flex align-items-start gap-3">
                  <span class="halo-section-icon {{#if (eq progress 100)}}bg-light-success text-success{{else}}bg-light-primary text-primary{{/if}}">
                    <i class="ti {{#if (eq progress 100)}}ti-circle-check{{else}}ti-book{{/if}}"></i>
                  </span>
                  <div class="flex-grow-1">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                      <div>
                        <h3 class="fs-5 fw-semibold mb-1">{{subtopicT id 'name'}}</h3>
                        <p class="mb-0 text-muted small" style="text-align: justify;">{{subtopicT id 'description'}}</p>
                      </div>                      
                      {{#if image}}
                        <img class="rounded-2" src="{{image}}" alt="{{subtopicT id 'name'}}" style="width: 100px; object-fit: cover; flex-shrink: 0;" />
                      {{/if}}
                    </div>
                  </div>
                </div>

                <div class="mt-auto d-flex align-items-center gap-3">
                  {{#unless (eq progress 100)}}
                  <div class="flex-grow-1">
                    <div class="progress" style="height: 6px;">
                      <div class="progress-bar bg-primary" role="progressbar" style="width: {{progress}}%"></div>
                    </div>
                    <span class="small text-muted">{{progress}}%</span>
                  </div>
                  {{/unless}}

                  <form class="subtopic-action-form" method="POST" action="/start-subtopic">
                    <input type="hidden" name="subtopicId" value="{{id}}">
                    <button
                      class="btn {{#if (eq progress 100)}}btn-outline-success{{else}}btn-primary{{/if}} subtopic-action-btn text-nowrap"
                      type="submit"
                    >
                      <i class="ti {{#if (eq progress 100)}}ti-refresh{{else}}ti-player-play{{/if}} me-1"></i>
                      {{#if (eq progress 100)}}
                        {{ t 'practice_plus.redo' }}
                      {{else}}
                        {{ t 'practice_plus.start' }}
                      {{/if}}
                    </button>
                  </form>
                </div>

              </div>
            </section>
          </div>
          {{/each}}

        </div>
      </div>
      {{/each}}
    </div>

    <!-- BOTTOM -->
    <div class="col-12">
      <section class="card border-0 shadow-sm">
        <div class="card-body p-4 d-flex align-items-center gap-3">
          <span class="halo-section-icon bg-dark-subtle text-dark">
            <i class="ti ti-lock"></i>
          </span>
          <div class="flex-grow-1">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-2">
              <div>
                <h3 class="fw-semibold mb-1">Progresso do Tópico {{topicT activeTopic.id 'name'}}</h3>
                <div class="text-muted small">Conteúdo bloqueado até atingir o próximo marco.</div>
              </div>
              <div class="badge bg-dark text-white px-3 py-2">5000XP</div>
            </div>
            <div class="progress" style="height: 10px; background-color: #dee2e6;">
              <div class="progress-bar bg-dark" role="progressbar" style="width: {{generalProgress}}%"></div>
            </div>
            <span class="small text-muted d-inline-block mt-2">{{generalProgress}}% concluído</span>
          </div>
          <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 bg-dark text-white flex-shrink-0">
            <i class="ti ti-lock"></i>
            <span class="fw-semibold">Bloqueado</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<script id="topics-data" type="application/json">
  {{{topicsJson}}}
</script>
<script src="/js/pages/practice-plus.js"></script>