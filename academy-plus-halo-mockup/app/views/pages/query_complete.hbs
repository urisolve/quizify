<div class="container-fluid">
  <div class="row g-4 justify-content-center">

    <!-- HERO -->
    <div class="col-12">
      <section class="card border-0 halo-hero-card overflow-hidden">
        <div class="card-body p-4 p-lg-5 text-center">
          <h1 class="display-5 fw-semibold mb-3">{{t 'query_complete.congratulations'}}</h1>

          <!-- Performance bolts -->
          <div class="d-flex justify-content-center gap-1 mb-3" id="performance-row">
            <span class="performance-bolts fs-3">
              {{#each (range filledBolts)}}
                <i class="bi bi-lightning-charge-fill bolt-lightning"></i>
              {{/each}}
              {{#each (range outlineBolts)}}
                <i class="bi bi-lightning-charge bolt-outline"></i>
              {{/each}}
            </span>
          </div>

          <!-- Performance message -->
          <div class="fs-5 fw-semibold mb-0">
            {{#if leveledUp}}
              🎉 <strong>{{t 'query_complete.level_up'}}</strong> 🎉
            {{else}}
              {{#if (eq performanceMessageKey 'query_complete.perfect')}}
                ⚡ <strong>{{t 'query_complete.perfect'}}</strong> ⚡
              {{else if (eq performanceMessageKey 'query_complete.excellent')}}
                🌟 <strong>{{t 'query_complete.excellent'}}</strong> 🌟
              {{else if (eq performanceMessageKey 'query_complete.great_job')}}
                🎯 <strong>{{t 'query_complete.great_job'}}</strong> 🎯
              {{else if (eq performanceMessageKey 'query_complete.good_work')}}
                👍 <strong>{{t 'query_complete.good_work'}}</strong> 👍
              {{else if (eq performanceMessageKey 'query_complete.nice_try')}}
                💪 <strong>{{t 'query_complete.nice_try'}}</strong> 💪
              {{else}}
                🔥 <strong>{{t 'query_complete.keep_going'}}</strong> 🔥
              {{/if}}
            {{/if}}
          </div>

        </div>
      </section>
    </div>

    <!-- SCORE + EXP BAR -->
    <div class="col-12 col-lg-6">
      <section class="card h-100">
        <div class="card-body p-4 d-flex flex-column gap-4">

          <!-- Weekly points -->
          <div class="d-flex align-items-center gap-3">
            <span class="halo-section-icon bg-light-warning text-warning">
              <i class="ti ti-trophy"></i>
            </span>
            <div class="flex-grow-1">
              <p class="mb-1 text-muted small">{{t 'query_complete.weekly_points'}}</p>
              <div class="d-flex align-items-center gap-2">
                <span class="fw-bold fs-4">{{weeklyScore}}</span>
                <span class="badge bg-success-subtle text-success fw-semibold">+{{score}}</span>
              </div>
            </div>
          </div>

          <!-- EXP bar -->
          <div>
            <p class="mb-2 text-muted small fw-medium">{{t 'query_complete.experience'}}</p>
            <div class="points-bar-container"
              data-percent="{{expBarPercent}}"
              data-percent-prev="{{expBarPercentPrev}}"
              data-leveled-up="{{leveledUp}}">
              <div class="points-bar-bg">
                <div class="points-bar-fill points-bar-fill-prev" id="points-bar-fill-prev"></div>
                <div class="points-bar-fill points-bar-fill-new" id="points-bar-fill-new"></div>
              </div>
            </div>
            {{#if leveledUp}}
              <p class="mt-2 small text-success fw-semibold">{{t 'query_complete.levelup'}}</p>
            {{/if}}
          </div>

          <div class="mt-auto">
            <a href="/practice-plus" class="btn btn-primary w-100 py-2 fw-semibold">
              <i class="ti ti-arrow-right me-2"></i>{{t 'query_complete.continue_btn'}}
            </a>
          </div>

        </div>
      </section>
    </div>

    <!-- QUESTION REVIEW -->
    <div class="col-12">
      <section class="card">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-4">
            <span class="halo-section-icon bg-light-primary text-primary">
              <i class="ti ti-list-check"></i>
            </span>
            <h2 class="card-title fw-semibold mb-0 fs-5">{{t 'query_complete.review_title'}}</h2>
            <div class="d-flex align-items-center gap-2 text-muted small">
              <i class="ti ti-clock"></i>
              <span>{{t 'query_complete.totaltime'}} <strong>{{totalTimeFormatted}}</strong></span>
            </div>
          </div>

          <div class="d-flex flex-column gap-3">
            {{#each results}}
              <div class="p-3 rounded-3 border {{#if this.correct}}border-success bg-success-subtle{{else}}border-danger bg-danger-subtle{{/if}}">
                <div class="d-flex align-items-start gap-2 mb-2">
                  <i class="ti {{#if this.correct}}ti-circle-check text-success{{else}}ti-circle-x text-danger{{/if}} fs-5 flex-shrink-0 mt-1"></i>
                  <p class="mb-0 fw-medium">{{loc this.questionText}}</p>
                  {{#if this.timeSeconds}}
                    <p class="mb-0 text-muted small">
                      <i class="ti ti-clock me-1"></i>{{this.timeSeconds}}s
                    </p>
                  {{/if}}
                </div>
                <div class="ms-4 small">
                  {{#unless this.correct}}
                    <p class="mb-1 text-danger">
                      <span class="fw-semibold">{{t 'query_complete.useranswer'}}</span> {{this.userAnswer}}
                    </p>
                  {{/unless}}
                  <p class="mb-1 text-success">
                    <span class="fw-semibold">{{t 'query_complete.correctanswer'}}</span> {{loc this.correctAnswer}}
                  </p>
                  {{#if (loc this.feedback)}}
                    <p class="mb-0 text-muted fst-italic">
                      <i class="ti ti-info-circle me-1"></i>{{loc this.feedback}}
                    </p>
                  {{/if}}
                </div>
              </div>
            {{/each}}
          </div>

        </div>
      </section>
    </div>

  </div>
</div>

<audio id="completion-jingle" src="/sounds/complete-jingle.mp3"></audio>
<audio id="level-up-sound" src="/sounds/level-up.mp3"></audio>
<script src="/js/utils/fireworks.js"></script>
<script src="/js/pages/query_complete.js"></script>