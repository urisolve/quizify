<div class="container-fluid">
  <div class="row g-4 justify-content-center">

    <!-- HERO -->
    <div class="col-12">
      <section class="card border-0 halo-hero-card overflow-hidden">
        <div class="card-body p-4 p-lg-5 text-center">
          <h1 class="display-5 fw-semibold mb-3">{{t 'query_complete.congratulations'}}</h1>

          <!-- Performance bolts -->
          <div class="d-flex justify-content-center gap-1 mb-3" id="performance-row">
            <span class="performance-bolts fs-3">
              {{#each (range filledBolts)}}
                <i class="bi bi-lightning-charge-fill bolt-lightning"></i>
              {{/each}}
              {{#each (range outlineBolts)}}
                <i class="bi bi-lightning-charge bolt-outline"></i>
              {{/each}}
            </span>
          </div>

          <!-- Performance message -->
          <div class="fs-5 fw-semibold mb-0">
            {{#if leveledUp}}
              🎉 <strong>{{t 'query_complete.level_up'}}</strong> 🎉
            {{else}}
              {{#if (eq performanceMessageKey 'query_complete.perfect')}}
                ⚡ <strong>{{t 'query_complete.perfect'}}</strong> ⚡
              {{else if (eq performanceMessageKey 'query_complete.excellent')}}
                🌟 <strong>{{t 'query_complete.excellent'}}</strong> 🌟
              {{else if (eq performanceMessageKey 'query_complete.great_job')}}
                🎯 <strong>{{t 'query_complete.great_job'}}</strong> 🎯
              {{else if (eq performanceMessageKey 'query_complete.good_work')}}
                👍 <strong>{{t 'query_complete.good_work'}}</strong> 👍
              {{else if (eq performanceMessageKey 'query_complete.nice_try')}}
                💪 <strong>{{t 'query_complete.nice_try'}}</strong> 💪
              {{else}}
                🔥 <strong>{{t 'query_complete.keep_going'}}</strong> 🔥
              {{/if}}
            {{/if}}
          </div>

        </div>
      </section>
    </div>

    <!-- SCORE + EXP BAR -->
    <div class="col-12 col-lg-6">
      <section class="card h-100">
        <div class="card-body p-4 d-flex flex-column gap-4">

          <!-- Weekly points -->
          <div class="d-flex align-items-center gap-3">
            <span class="halo-section-icon bg-light-warning text-warning">
              <i class="ti ti-trophy"></i>
            </span>
            <div class="flex-grow-1">
              <p class="mb-1 text-muted small">{{t 'query_complete.weekly_points'}}</p>
              <div class="d-flex align-items-center gap-2">
                <span class="fw-bold fs-4">{{weeklyScore}}</span>
                <span class="badge bg-success-subtle text-success fw-semibold">+{{score}}</span>
              </div>
            </div>
          </div>

          <!-- EXP bar -->
          <div>
            <p class="mb-2 text-muted small fw-medium">{{t 'query_complete.experience'}}</p>
            <div class="points-bar-container"
              data-percent="{{expBarPercent}}"
              data-percent-prev="{{expBarPercentPrev}}"
              data-leveled-up="{{leveledUp}}">
              <div class="points-bar-bg">
                <div class="points-bar-fill points-bar-fill-prev" id="points-bar-fill-prev"></div>
                <div class="points-bar-fill points-bar-fill-new" id="points-bar-fill-new"></div>
              </div>
            </div>
            {{#if leveledUp}}
              <p class="mt-2 small text-success fw-semibold">{{t 'query_complete.levelup'}}</p>
            {{/if}}
          </div>

          <div class="mt-auto">
            <a href="/practice-plus" class="btn btn-primary w-100 py-2 fw-semibold">
              <i class="ti ti-arrow-right me-2"></i>{{t 'query_complete.continue_btn'}}
            </a>
          </div>

        </div>
      </section>
    </div>

    <!-- QUESTION REVIEW -->
    <div class="col-12">
      <section class="card">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-4">
            <span class="halo-section-icon bg-light-primary text-primary">
              <i class="ti ti-list-check"></i>
            </span>
            <h2 class="card-title fw-semibold mb-0 fs-5">{{t 'query_complete.review_title'}}</h2>
            <div class="d-flex align-items-center gap-2 text-muted small">
              <i class="ti ti-clock"></i>
              <span>{{t 'query_complete.totaltime'}} <strong>{{totalTimeFormatted}}</strong></span>
            </div>
          </div>

          <div class="d-flex flex-column gap-3">
            {{#each results as |result|}}
              <div class="p-3 rounded-3 border {{#if this.correct}}border-success bg-success-subtle{{else}}border-danger bg-danger-subtle{{/if}}">
                <div class="d-flex align-items-start gap-2 mb-2">
                  <i class="ti {{#if this.correct}}ti-circle-check text-success{{else}}ti-circle-x text-danger{{/if}} fs-5 flex-shrink-0 mt-1"></i>
                  <p class="mb-0 fw-medium">{{loc this.questionText}}</p>
                  {{#if this.timeSeconds}}
                    <p class="mb-0 text-muted small">
                      <i class="ti ti-clock me-1"></i>{{this.timeSeconds}}s
                    </p>
                  {{/if}}
                </div>
                <div class="ms-4 small">
                  {{#unless this.correct}}
                    <p class="mb-1 text-danger">
                      <span class="fw-semibold">{{t 'query_complete.useranswer'}}</span> {{this.userAnswer}}
                    </p>
                  {{/unless}}
                  <p class="mb-1 text-success">
                    <span class="fw-semibold">{{t 'query_complete.correctanswer'}}</span> {{loc this.correctAnswer}}
                  </p>
                  {{#if (loc this.feedback)}}
                    <p class="mb-0 text-muted fst-italic">
                      <i class="ti ti-info-circle me-1"></i>{{loc this.feedback}}
                    </p>
                  {{/if}}
                </div>

                <!-- RATE THIS QUESTION (collapsible) -->
                <div class="ms-4 mt-3">
                  <button type="button"
                    class="btn btn-sm btn-outline-secondary rate-question-toggle"
                    data-target="rate-section-{{@index}}">
                    <i class="ti ti-star me-1"></i>{{t 'query_complete.rate_question_btn'}}
                  </button>
 
                  <div id="rate-section-{{@index}}" class="rate-question-section d-none mt-2">
                    <form class="rate-question-form" data-question-id="{{this.questionId}}">
                      <input type="hidden" name="questionId" value="{{this.questionId}}">

                      <p class="mb-2 small fw-semibold">{{t 'feedback.metrics_title'}}</p>

                      {{#each (rangestart 1 6) as |n|}}
                        <div class="border rounded-3 p-2 mb-2">
                          <div class="row align-items-center g-2">
                            <div class="col-3 fw-semibold small">{{t (concat 'feedback.m' n '_title')}}</div>
                            <div class="col-5 text-muted small">{{t (concat 'feedback.m' n '_statement')}}</div>
                            <div class="col-4">
                              <div class="btn-group btn-group-sm w-100" role="group" aria-label="M{{n}}">
                                {{#each (rangestart 1 5) as |v|}}
                                  <input type="radio" class="btn-check"
                                        name="m{{n}}"
                                        id="qc-{{result.questionId}}-m{{n}}-{{v}}"
                                        value="{{v}}"
                                        {{#if (eq v (lookup result.previousFeedback (concat 'm' n)))}}checked{{/if}}>
                                  <label class="btn btn-sm btn-outline-secondary"
                                        for="qc-{{result.questionId}}-m{{n}}-{{v}}">{{v}}</label>
                                {{/each}}
                              </div>
                            </div>
                          </div>
                        </div>
                      {{/each}}

                      <div class="mt-2">
                        <label class="form-label fw-semibold small" for="qc-comment-{{this.questionId}}">
                          {{t 'feedback.comment_label'}}
                        </label>
                        <textarea class="form-control form-control-sm"
                                  id="qc-comment-{{this.questionId}}"
                                  name="comment" rows="2"
                                  placeholder="{{t 'feedback.comment_placeholder'}}">{{this.previousFeedback.comment}}</textarea>
                      </div>

                      <div class="d-flex align-items-center gap-2 mt-2">
                        <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                          <i class="ti ti-send me-1"></i>{{t 'query_complete.submit_rating'}}
                        </button>
                        <span class="rate-success small text-success d-none">
                          <i class="ti ti-circle-check me-1"></i>{{t 'query_complete.rating_thanks'}}
                        </span>
                        <span class="rate-error small text-danger d-none">
                          <i class="ti ti-alert-circle me-1"></i><span class="rate-error-message"></span>
                        </span>
                      </div>
                    </form>
                  </div>
                </div>

              </div>
            {{/each}}
          </div>

        </div>
      </section>
    </div>


    <!-- MANDATORY FEEDBACK -->
    {{#if mandatoryFeedback}}
      <div class="modal fade" id="mandatoryFeedbackModal" tabindex="-1"
          data-bs-backdrop="static" data-bs-keyboard="false"
          aria-labelledby="mandatoryFeedbackTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title fw-semibold" id="mandatoryFeedbackTitle">
                <i class="ti ti-star me-2 text-warning"></i>{{ t 'query_complete.mandatory_title' }}
              </h5>
              {{!-- No close button --}}
            </div>

            <div class="modal-body">
              <p class="text-muted small mb-3">{{ t 'query_complete.mandatory_subtitle' }}</p>

              <div class="border rounded-3 p-3 bg-light mb-3">
                <p class="fw-semibold mb-2">{{loc mandatoryFeedback.questionText}}</p>
                <p class="mb-0 text-success small">
                  <span class="fw-semibold">{{t 'query_complete.correctanswer'}}</span>
                  {{loc mandatoryFeedback.correctAnswer}}
                </p>
                {{#if (loc mandatoryFeedback.feedback)}}
                  <p class="mt-2 mb-0 text-muted fst-italic small">
                    <i class="ti ti-info-circle me-1"></i>{{loc mandatoryFeedback.feedback}}
                  </p>
                {{/if}}
              </div>

              <form id="mandatory-feedback-form" class="d-grid gap-2">
                <input type="hidden" name="questionId" value="{{mandatoryFeedback.questionId}}">

                <p class="mb-2 small fw-semibold">{{t 'feedback.metrics_title'}}</p>

                {{#each (rangestart 1 6) as |n|}}
                  <div class="border rounded-3 p-2 mb-2">
                    <div class="row align-items-center g-2">
                      <div class="col-3 fw-semibold small">{{t (concat 'feedback.m' n '_title')}}</div>
                      <div class="col-5 text-muted small">{{t (concat 'feedback.m' n '_statement')}}</div>
                      <div class="col-4">
                        <div class="btn-group btn-group-sm w-100" role="group" aria-label="M{{n}}">
                          {{#each (rangestart 1 5) as |v|}}
                            <input type="radio" class="btn-check"
                                  name="m{{n}}"
                                  id="mf-m{{n}}-{{v}}"
                                  value="{{v}}">
                            <label class="btn btn-sm btn-outline-secondary"
                                  for="mf-m{{n}}-{{v}}">{{v}}</label>
                          {{/each}}
                        </div>
                      </div>
                    </div>
                  </div>
                {{/each}}

                <div class="mt-2">
                  <label class="form-label fw-semibold small" for="mf-comment">
                    {{t 'feedback.comment_label'}}
                  </label>
                  <textarea class="form-control form-control-sm"
                            id="mf-comment" name="comment" rows="2"
                            placeholder="{{t 'feedback.comment_placeholder'}}"></textarea>
                </div>

                <button type="submit" class="btn btn-primary fw-semibold mt-3">
                  <span class="btn-label">
                    <i class="ti ti-send me-1"></i>{{t 'query_complete.submit_rating'}}
                  </span>
                  <span class="btn-loading d-none">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    {{t 'query_complete.submitting'}}
                  </span>
                </button>

                <div id="mandatory-feedback-error"
                    class="alert alert-danger d-none mb-0 small mt-2"></div>
              </form>
            </div>
          </div>
        </div>
      </div>
    {{/if}}

  </div>
</div>

<audio id="completion-jingle" src="/sounds/complete-jingle.mp3"></audio>
<audio id="level-up-sound" src="/sounds/level-up.mp3"></audio>
<script src="/js/utils/fireworks.js"></script>
<script src="/js/pages/query_complete.js"></script>