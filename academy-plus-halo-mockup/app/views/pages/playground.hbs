<div class="container-fluid">
  <div class="row g-4">
 
    <!-- Hero -->
    <div class="col-12">
      <section class="card border-0 halo-hero-card overflow-hidden">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3">
            <span class="halo-section-icon bg-light-primary text-primary">
              <i class="ti ti-rocket"></i>
            </span>
            <div>
              <h2 class="card-title fw-semibold mb-0">{{ t 'playground.title' }}</h2>
              <p class="mb-0 text-muted small">{{ t 'playground.subtitle' }}</p>
            </div>
          </div>
        </div>
      </section>
    </div>
 
    <!-- Action cards -->

    <!-- PMB -->
    <div class="col d-flex flex-column gap-4">
      <!-- Create PMB -->
      <section class="card flex-grow-1 mb-0">
        <div class="card-body p-4 d-flex flex-column gap-3">
          <div class="d-flex align-items-start gap-3">
            <span class="halo-section-icon bg-light-success text-success">
              <i class="ti ti-file-description"></i>
            </span>
            <div class="flex-grow-1">
              <h3 class="fs-5 fw-semibold mb-1">{{ t 'playground.pmbtitle' }}</h3>
              <p class="mb-0 text-muted small" style="text-align: justify;">{{ t 'playground.pmbsubtitle' }}</p>
            </div>
          </div>

          <div class="mt-auto">
            <form method="POST" action="/playground/create-pmb" class="d-flex flex-column gap-3" data-disable-on-submit>
              <div>
                <label class="form-label fw-semibold mb-1" for="pmbDifficulty">
                  {{ t 'playground.pmb_difficulty_label' }}
                </label>
                <select class="form-select" id="pmbDifficulty" name="difficulty" required>
                  <option value="1">{{ t 'playground.pmb_difficulty_1' }}</option>
                  <option value="2">{{ t 'playground.pmb_difficulty_2' }}</option>
                  <option value="3" selected>{{ t 'playground.pmb_difficulty_3' }}</option>
                  <option value="4">{{ t 'playground.pmb_difficulty_4' }}</option>
                  <option value="5">{{ t 'playground.pmb_difficulty_5' }}</option>
                </select>
              </div>

              <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">
                <span class="btn-label">
                  <i class="ti ti-plus me-2"></i>{{ t 'playground.pmbbutton' }}
                </span>
                <span class="btn-loading d-none">
                  <span class="spinner-border spinner-border-sm me-2"
                        role="status" aria-hidden="true"></span>
                  {{ t 'playground.loading' }}
                </span>
              </button>
            </form>
          </div>
        </div>
      </section>
      
      <!-- Review PMB -->
      <section class="card flex-grow-1 mb-0">
        <div class="card-body p-4 d-flex flex-column gap-3">
          <div class="d-flex align-items-start gap-3">
            <span class="halo-section-icon bg-light-info text-info">
              <i class="ti ti-file-search"></i>
            </span>
            <div class="flex-grow-1">
              <h3 class="fs-5 fw-semibold mb-1">{{ t 'playground.pmb_review_title' }}</h3>
              <p class="mb-0 text-muted small" style="text-align: justify;">
                {{ t 'playground.pmb_review_subtitle' }}
              </p>
            </div>
          </div>

          <div class="mt-auto">
            <form method="GET" action="/playground/pmb/review" class="d-flex flex-column gap-3">
              <div>
                <label class="form-label fw-semibold mb-1" for="pmbId">
                  {{ t 'playground.pmb_id_label' }}
                </label>
                <select class="form-select" id="pmbId" name="pmbId" required>
                  <option value="" disabled selected>
                    {{ t 'playground.pmb_id_placeholder' }}
                  </option>
                  {{#each pmbs}}
                    <option value="{{this.id}}">
                      #{{this.id}} — {{this.filename}}{{#if this.sizeKb}} ({{this.sizeKb}} KB){{/if}}
                    </option>
                  {{/each}}
                </select>
              </div>

              <button class="btn btn-info text-white w-100 py-2 fw-semibold" type="submit">
                <i class="ti ti-eye me-2"></i>{{ t 'playground.pmb_review_button' }}
              </button>
            </form>
          </div>
        </div>
      </section>
    </div>

    <!-- Create Questions --> 
    <div class="col">
      <section class="card h-100">
        <div class="card-body p-4 d-flex flex-column gap-3">
          <div class="d-flex align-items-start gap-3">
            <span class="halo-section-icon bg-light-warning text-warning">
              <i class="ti ti-list-check"></i>
            </span>
            <div class="flex-grow-1">
              <h3 class="fs-5 fw-semibold mb-1">{{ t 'playground.questiontitle' }}</h3>
              <p class="mb-0 text-muted small" style="text-align: justify;">{{ t 'playground.questionsubtitle' }}</p>
            </div>
          </div>
 
          <div class="mt-auto">
            <form method="POST" action="/playground/create-questions" class="d-flex flex-column gap-3" data-disable-on-submit>
              <input type="hidden" name="questionFocus" value="topology" />

              <div>
                <label class="form-label fw-semibold mb-1" for="pmbSourceMode">
                  {{ t 'playground.pmb_source_mode_label' }}
                </label>
                <select class="form-select" id="pmbSourceMode" name="pmbSourceMode" required>
                  <option value="random_any" selected>{{ t 'playground.pmb_source_mode_random_any' }}</option>
                  <option value="random_by_level">{{ t 'playground.pmb_source_mode_random_level' }}</option>
                  <option value="specific_pmb">{{ t 'playground.pmb_source_mode_specific' }}</option>
                </select>
              </div>

              <div id="question-pmb-difficulty-wrap" class="d-none">
                <label class="form-label fw-semibold mb-1" for="questionPmbDifficultyLevel">
                  {{ t 'playground.pmb_filter_difficulty_label' }}
                </label>
                <select class="form-select" id="questionPmbDifficultyLevel" name="pmbDifficultyLevel">
                  <option value="1">{{ t 'playground.pmb_difficulty_1' }}</option>
                  <option value="2">{{ t 'playground.pmb_difficulty_2' }}</option>
                  <option value="3" selected>{{ t 'playground.pmb_difficulty_3' }}</option>
                  <option value="4">{{ t 'playground.pmb_difficulty_4' }}</option>
                  <option value="5">{{ t 'playground.pmb_difficulty_5' }}</option>
                </select>
              </div>

              <div id="question-pmb-select-wrap" class="d-none">
                <label class="form-label fw-semibold mb-1" for="pmbId">
                  {{ t 'playground.pmb_source_label' }}
                </label>
                <select class="form-select" id="pmbId" name="pmbId">
                  <option value="" selected>{{ t 'playground.pmb_id_placeholder' }}</option>
                  {{#each pmbs}}
                    <option
                      value="{{this.id}}"
                      data-difficulty-level="{{this.difficultyLevel}}"
                    >
                      #{{this.id}} — {{this.filename}}{{#if this.difficultyLevel}} ({{ t 'playground.pmb_difficulty_short' }} {{this.difficultyLevel}}){{/if}}
                    </option>
                  {{/each}}
                </select>
              </div>

              <div>
                <label class="form-label fw-semibold mb-1" for="model">
                  {{ t 'playground.model_label' }}
                </label>
                <select class="form-select" id="model" name="model" required>
                  <option value="gpt-oss:20b" selected>gpt-oss:20b</option>
                  <option value="llama3.3:70b">llama3.3:70b</option>
                  <option value="lcm-full:latest">lcm-full:latest</option>
                  <option value="deepseek-r1:8b">deepseek-r1:8b</option>
                  <option value="llama3.1:8b">llama3.1:8b</option>
                  <option value="llama3.2:3b">llama3.2:3b</option>
                </select>
              </div>

              <div>
                <label class="form-label fw-semibold mb-1" for="subtopicId"> {{t 'playground.subtopic_label'}}</label>
                <select class="form-select" id="subtopicId" name="subtopicId" required>
                  {{#each subtopics}}
                    <option value="{{this.id}}">{{loc this.title}}</option>
                  {{/each}}
                </select>
              </div>

              <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">
                <span class="btn-label">
                  <i class="ti ti-plus me-2"></i>{{ t 'playground.questionbutton' }}
                </span>
                <span class="btn-loading d-none">
                  <span class="spinner-border spinner-border-sm me-2"
                        role="status" aria-hidden="true"></span>
                  {{ t 'playground.loading' }}
                </span>
              </button>
            </form>
          </div>
        </div>
      </section>
    </div>

    <!-- Review Questions -->
    <div class="col">
      <section class="card h-100">
        <div class="card-body p-4 d-flex flex-column gap-3">
          <div class="d-flex align-items-start gap-3">
            <span class="halo-section-icon bg-light-info text-info">
              <i class="ti ti-eye-check"></i>
            </span>
            <div class="flex-grow-1">
              <h3 class="fs-5 fw-semibold mb-1">{{ t 'playground.reviewtitle' }}</h3>
              <p class="mb-0 text-muted small" style="text-align: justify;">{{ t 'playground.reviewsubtitle' }}</p>
            </div>
          </div>
 
          <div class="mt-auto d-grid gap-2">
            <a href="/playground/review?mode=all"
              class="btn btn-primary py-2 fw-semibold">
              <i class="ti ti-eye me-2"></i>{{t 'playground.review_all'}}
            </a>
            <!--<a href="/playground/review?mode=critical"
              class="btn btn-outline-danger py-2 fw-semibold">
              <i class="ti ti-alert-triangle me-2"></i>{{t 'playground.review_critical'}}
            </a>-->
            <a href="/playground/review?mode=unrated"
              class="btn btn-outline-secondary py-2 fw-semibold">
              <i class="ti ti-help-circle me-2"></i>{{t 'playground.review_unrated'}}
            </a>
          </div>
        </div>
      </section>
    </div>

    <!-- Edit Prompts -->
    <div class="col-12">
      <section class="card border-0 shadow-sm">
        <div class="card-body p-4 d-flex flex-column gap-4">
          <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="d-flex align-items-start gap-3">
              <span class="halo-section-icon bg-light-secondary text-secondary">
                <i class="ti ti-edit"></i>
              </span>
              <div>
                <h3 class="fs-5 fw-semibold mb-1">{{ t 'playground.prompts_title' }}</h3>
                <p class="mb-0 text-muted small" style="text-align: justify;">
                  {{ t 'playground.prompts_subtitle' }}
                </p>
              </div>
            </div>

            <div class="w-100 w-lg-auto" style="max-width: 320px;">
              <label class="form-label fw-semibold mb-1" for="promptSubtopicFilter">{{ t 'playground.prompts_filter_label' }}</label>
              <select class="form-select" id="promptSubtopicFilter" name="promptSubtopicFilter">
                {{#each promptSubtopics}}
                  <option value="{{this.id}}" {{#if (eq this.id 1)}}selected{{/if}}>{{loc this.title}}</option>
                {{/each}}
              </select>
            </div>
          </div>

          <div class="d-flex flex-column gap-3" id="prompt-list">
            {{#each prompts}}
              <article class="card border prompt-item" data-prompt-subtopic-id="{{this.subtopicId}}">
                <div class="card-body p-3 p-lg-4">
                  <form method="POST" action="/playground/prompts/{{this.id}}" class="d-grid gap-3" data-disable-on-submit>
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                      <div>
                        <div class="text-muted small">Prompt #{{this.id}} · Subtópico {{this.subtopicId}}</div>
                        <h4 class="h6 fw-semibold mb-0">{{this.subtopicTitle}} · {{this.subject}}</h4>
                      </div>
                      <div class="text-muted small">
                        {{this.numberQuestions}} pergunta(s) gerada(s)
                      </div>
                    </div>

                    <div>
                      <label class="form-label fw-semibold mb-1" for="prompt-subject-{{this.id}}">{{ t 'playground.prompts_theme_label' }}</label>
                      <input
                        class="form-control"
                        id="prompt-subject-{{this.id}}"
                        name="subject"
                        type="text"
                        value="{{this.subject}}"
                        required
                      />
                    </div>

                    <div>
                      <label class="form-label fw-semibold mb-1" for="prompt-text-{{this.id}}">{{ t 'playground.prompts_prompt_label' }}</label>
                      <textarea
                        class="form-control"
                        id="prompt-text-{{this.id}}"
                        name="prompt"
                        rows="4"
                        required
                      >{{this.prompt}}</textarea>
                    </div>

                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
                      <div class="text-muted small">
                        Última atualização: {{this.lastUpdateAt}}
                      </div>
                      <button class="btn btn-secondary fw-semibold px-4" type="submit">
                        <span class="btn-label">
                          <i class="ti ti-device-floppy me-2"></i>{{ t 'playground.prompts_save_button' }}
                        </span>
                        <span class="btn-loading d-none">
                          <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                          {{ t 'playground.prompts_saving' }}
                        </span>
                      </button>
                    </div>
                  </form>
                </div>
              </article>
            {{/each}}
          </div>
        </div>
      </section>
    </div>

    <!-- Flash banner -->
    {{#if flash}}
      <div class="col-12">
        <div
          id="playground-flash-banner"
          class="alert alert-{{flash.type}} d-flex align-items-center gap-2 mb-0"
          role="alert"
          data-flash-type="{{flash.type}}"
        >
          <i class="ti {{#if (eq flash.type 'success')}}ti-circle-check{{else}}ti-alert-circle{{/if}} fs-5"></i>
          <div id="playground-flash-message" data-generated-question="{{#if flash.generatedQuestion}}1{{else}}0{{/if}}">
            {{#if flash.generatedQuestion}}
              <div class="small fw-semibold text-uppercase text-muted mb-1">
                {{flash.generatedQuestion.promptSubtopic}} · {{flash.generatedQuestion.promptTheme}} · {{flash.generatedQuestion.model}}
              </div>
            {{/if}}
            {{#if flash.messageKey}}{{t flash.messageKey flash.messageVars}}
            {{else}}{{flash.message}}{{/if}}
          </div>
        </div>
      </div>

      {{#if flash.generatedQuestion}}
        <div
          class="offcanvas playground-question-offcanvas"
          tabindex="-1"
          id="playground-question-offcanvas"
          aria-labelledby="playgroundQuestionOffcanvasLabel"
          data-generated-question="1"
          data-bs-backdrop="static"
          data-bs-scroll="false"
        >
          <div class="offcanvas-header border-bottom">
            <div>
              <h2 class="offcanvas-title fw-semibold mb-1 fs-5" id="playgroundQuestionOffcanvasLabel">
                {{ t 'playground.creation_lock_title' }}
              </h2>
              <p class="mb-0 text-muted small">{{ t 'playground.creation_lock_subtitle' }}</p>
            </div>
          </div>

          <div class="offcanvas-body d-flex flex-column gap-3">
            <div class="d-flex gap-2 align-items-center flex-wrap">
              <span class="badge bg-light-success text-success">{{ t 'playground.labelStatus' }}</span>
              <span class="badge bg-light-info text-info">PMB #{{flash.generatedQuestion.ragDocumentId}}</span>
              {{#if flash.generatedQuestion.pmbDifficultyLevel}}
                <span class="badge bg-light-warning text-warning">{{ t 'playground.pmb_difficulty_short' }} {{flash.generatedQuestion.pmbDifficultyLevel}}</span>
              {{/if}}
              <span class="badge bg-light-secondary text-secondary">{{flash.generatedQuestion.model}}</span>
            </div>

            <div class="border rounded-3 p-3 bg-light">
              <div class="text-muted small mb-1">{{ t 'playground.labelQuestion' }}</div>
              <div class="fw-semibold">{{flash.generatedQuestion.question_text}}</div>
            </div>

            <div class="row g-3">
              <div class="col-12 col-lg-4">
                <div class="border rounded-3 p-3 h-100">
                  <div class="text-muted small mb-1">{{ t 'playground.labelAnswer' }}</div>
                  <div>{{flash.generatedQuestion.correct_answer}}</div>
                </div>
              </div>
              <div class="col-12 col-lg-4">
                <div class="border rounded-3 p-3 h-100">
                  <div class="text-muted small mb-1">{{ t 'playground.labelDistractors' }}</div>
                  <div class="d-flex flex-column gap-2">
                    {{#each flash.generatedQuestion.incorrect_answer}}
                      <div class="border rounded-3 bg-white px-3 py-2 shadow-sm">
                        <span class="text-muted small me-2">{{letterIndex @index}}.</span>
                        <span>{{this}}</span>
                      </div>
                    {{/each}}
                  </div>
                </div>
              </div>
              <div class="col-12 col-lg-4">
                <div class="border rounded-3 p-3 h-100">
                  <div class="text-muted small mb-1">{{ t 'playground.labelFeedback' }}</div>
                  <div>{{flash.generatedQuestion.feedback}}</div>
                </div>
              </div>
            </div>

            {{#if flash.generatedQuestion.image}}
              <div>
                <div class="text-muted small mb-2">{{ t 'playground.labelImage' }}</div>
                <div class="border rounded-3 p-3 bg-white">
                  <img
                    src="{{flash.generatedQuestion.image}}"
                    alt="Circuit image selected by model"
                    class="img-fluid rounded"
                    style="max-height: 320px; object-fit: contain;"
                  />
                </div>
              </div>
            {{/if}}

            <div class="mt-2">
              <div class="d-flex align-items-center gap-3 mb-3">
                <span class="halo-section-icon bg-light-warning text-warning">
                  <i class="ti ti-star"></i>
                </span>
                <div>
                  <h2 class="card-title fw-semibold mb-0 fs-5">{{ t 'playgroundreview.evaluation' }}</h2>
                  <p class="mb-0 text-muted small">{{ t 'playground.creation_lock_hint' }}</p>
                </div>
              </div>

              <form method="POST" action="/playground/review/rate" class="d-grid gap-2" data-disable-on-submit>
                <input type="hidden" name="questionId" value="{{flash.generatedQuestion.id}}">
                <input type="hidden" name="return_to" value="playground">

                <p class="fw-semibold mb-2">{{ t 'feedback.metrics_title' }}</p>

                {{#each (rangestart 1 6) as |n|}}
                  <div class="border rounded-3 p-3">
                    <div class="row">
                      <div class="col-3 fw-semibold">{{t (concat 'feedback.m' n '_title')}}</div>
                      <div class="col-6 text-muted small">{{t (concat 'feedback.m' n '_statement')}}</div>
                      <div class="col-3">
                        <div class="btn-group w-100" role="group" aria-label="M{{n}}">
                          {{#each (rangestart 1 5) as |v|}}
                            <input type="radio" class="btn-check"
                                  name="m{{n}}" id="offcanvas-m{{n}}-{{v}}" value="{{v}}">
                            <label class="btn btn-sm btn-outline-secondary"
                                  for="offcanvas-m{{n}}-{{v}}">{{v}}</label>
                          {{/each}}
                        </div>
                      </div>
                    </div>
                  </div>
                {{/each}}

                <div class="mt-3">
                  <label class="form-label fw-semibold" for="offcanvas-comment">
                    {{ t 'feedback.comment_label' }}
                  </label>
                  <textarea class="form-control" id="offcanvas-comment" name="comment" rows="3"
                            placeholder="{{ t 'feedback.comment_placeholder' }}"></textarea>
                </div>

                <div class="d-flex gap-2 mt-3">
                  <button type="submit" class="btn btn-primary py-2 fw-semibold flex-grow-1">
                    <i class="ti ti-send me-2"></i>{{ t 'playgroundreview.submiteval' }}
                  </button>
                  <a href="/playground/questions/{{flash.generatedQuestion.id}}/edit"
                    class="btn btn-outline-primary py-2 fw-semibold">
                    <i class="ti ti-pencil me-2"></i>{{ t 'playground.edit_question' }}
                  </a>
                </div>
              </form>
            </div>
          </div>
        </div>
      {{/if}}
    {{/if}}
  
  </div>
</div>

<script src="/js/pages/playground.js"></script>
<script src="/js/pages/playground_review.js"></script>