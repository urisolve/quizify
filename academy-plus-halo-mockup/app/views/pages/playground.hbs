<div class="container-fluid">
  <div class="row g-4">
 
    <!-- Hero -->
    <div class="col-12">
      <section class="card border-0 halo-hero-card overflow-hidden">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3">
            <span class="halo-section-icon bg-light-primary text-primary">
              <i class="ti ti-rocket"></i>
            </span>
            <div>
              <h2 class="card-title fw-semibold mb-0">Playground</h2>
              <p class="mb-0 text-muted small">Generate new content for the platform.</p>
            </div>
          </div>
        </div>
      </section>
    </div>
 
    <!-- Action cards -->

    <!-- Create PMB -->
    <div class="col">
      <section class="card h-100">
        <div class="card-body p-4 d-flex flex-column gap-3">
          <div class="d-flex align-items-start gap-3">
            <span class="halo-section-icon bg-light-success text-success">
              <i class="ti ti-file-description"></i>
            </span>
            <div class="flex-grow-1">
              <h3 class="fs-5 fw-semibold mb-1">Create PMB</h3>
              <p class="mb-0 text-muted small" style="text-align: justify;">
                Generate a new PMB entry and store it in the database.
              </p>
            </div>
          </div>
 
          <div class="mt-auto">
            <form method="POST" action="/playground/create-pmb">
              <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">
                <i class="ti ti-plus me-2"></i>Create PMB
              </button>
            </form>
          </div>
        </div>
      </section>
    </div>

    <!-- Create Questions --> 
    <div class="col">
      <section class="card h-100">
        <div class="card-body p-4 d-flex flex-column gap-3">
          <div class="d-flex align-items-start gap-3">
            <span class="halo-section-icon bg-light-warning text-warning">
              <i class="ti ti-list-check"></i>
            </span>
            <div class="flex-grow-1">
              <h3 class="fs-5 fw-semibold mb-1">Create Questions</h3>
              <p class="mb-0 text-muted small" style="text-align: justify;">
                Generate new questions and store them in the database.
              </p>
            </div>
          </div>
 
          <div class="mt-auto">
            <form method="POST" action="/playground/create-questions" class="d-flex flex-column gap-3">
              <input type="hidden" name="questionFocus" value="topology" />

              <div>
                <label class="form-label fw-semibold mb-1" for="topologyTarget">Topology focus</label>
                <select class="form-select" id="topologyTarget" name="topologyTarget">
                  <option value="any" selected>Any (Nós, Ramos, or Malhas)</option>
                  <option value="nodes">Nós</option>
                  <option value="branches">Ramos</option>
                  <option value="meshes">Malhas</option>
                </select>
                <div class="form-text">The generated question will focus on topology counts or structure interpretation.</div>
              </div>

              <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">
                <i class="ti ti-plus me-2"></i>Create Questions
              </button>
            </form>
          </div>
        </div>
      </section>
    </div>

    <!-- Review Questions -->
    <div class="col">
      <section class="card h-100">
        <div class="card-body p-4 d-flex flex-column gap-3">
          <div class="d-flex align-items-start gap-3">
            <span class="halo-section-icon bg-light-info text-info">
              <i class="ti ti-eye-check"></i>
            </span>
            <div class="flex-grow-1">
              <h3 class="fs-5 fw-semibold mb-1">Review Questions</h3>
              <p class="mb-0 text-muted small" style="text-align: justify;">
                Inspect a small batch of questions and flag any that look low quality.
              </p>
            </div>
          </div>
 
          <div class="mt-auto">
            <a href="/playground/review" class="btn btn-primary w-100 py-2 fw-semibold">
              <i class="ti ti-eye me-2"></i>Start review
            </a>            
          </div>
        </div>
      </section>
    </div>

    <!-- Flash banner -->
    {{#if flash}}
      <div class="col-12">
        <div class="alert alert-{{flash.type}} d-flex align-items-center gap-2 mb-0" role="alert">
          <i class="ti {{#if (eq flash.type 'success')}}ti-circle-check{{else}}ti-alert-circle{{/if}} fs-5"></i>
          <div>{{flash.message}}</div>
        </div>
      </div>
    {{/if}}

    {{#if flash}}
      {{#if (eq flash.type 'success')}}
        {{#if flash.generatedQuestion}}
      <div class="col-12">
        <section class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
              <div>
                <h3 class="fs-5 fw-semibold mb-1">Latest generated question</h3>
                <p class="mb-0 text-muted small">The question that was just created and stored in the database.</p>
              </div>
              <span class="badge bg-light-success text-success">Saved</span>
            </div>

            <div class="border rounded-3 p-3 bg-light mb-3">
              <div class="text-muted small mb-1">Question</div>
              <div class="fw-semibold">{{flash.generatedQuestion.question_text}}</div>
            </div>

            <div class="row g-3">
              <div class="col-12 col-lg-4">
                <div class="border rounded-3 p-3 h-100">
                  <div class="text-muted small mb-1">Correct answer</div>
                  <div>{{flash.generatedQuestion.correct_answer}}</div>
                </div>
              </div>
              <div class="col-12 col-lg-4">
                <div class="border rounded-3 p-3 h-100">
                  <div class="text-muted small mb-1">Distractors</div>
                  <div class="d-flex flex-column gap-2">
                    {{#each flash.generatedQuestion.incorrect_answer}}
                      <div class="border rounded-3 bg-white px-3 py-2 shadow-sm">
                        <span class="text-muted small me-2">{{letterIndex @index}}.</span>
                        <span>{{this}}</span>
                      </div>
                    {{/each}}
                  </div>
                </div>
              </div>
              <div class="col-12 col-lg-4">
                <div class="border rounded-3 p-3 h-100">
                  <div class="text-muted small mb-1">Feedback</div>
                  <div>{{flash.generatedQuestion.feedback}}</div>
                </div>
              </div>
            </div>

            {{#if flash.generatedQuestion.image}}
              <div class="mt-3">
                <div class="text-muted small mb-2">Circuit image selected by the model</div>
                <div class="border rounded-3 p-3 bg-white">
                  <img
                    src="{{flash.generatedQuestion.image}}"
                    alt="Circuit image selected by model"
                    class="img-fluid rounded"
                    style="max-height: 320px; object-fit: contain;"
                  />
                </div>
              </div>
            {{/if}}
          </div>
        </section>
      </div>
        {{/if}}
      {{/if}}
    {{/if}}
  
  </div>
</div>